manifest {
    name            = 'colabbio/cb-slidelab-abmil'
    author          = 'Lorenzo Olmo Marchal'
    homePage        = 'https://github.com/colabbio/cb-slidelab-abmil'
    description     = 'Scalable WSI SlideLab neural feature extraction and Attention-based Deep MIL training with MedVFS zero-download support.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '2.1.0'
    defaultBranch   = 'main'
}

params {
    // Data & Mounting Paths
    vfs_mount          = '/data/vfs'
    slides_path        = ''
    cohort_csv         = '/data/cohort_real_brca.csv'
    output_dir         = 'results'
    
    // Hardware & Compute
    device             = (System.getenv("CUDA_VISIBLE_DEVICES") != null || file('/proc/driver/nvidia/version').exists()) ? 'cuda' : 'cpu'
    
    // OMERO Integration
    omero_host         = 'colabbio-omero'
    sync_omero         = false
    
    // Cloud & Storage
    auto_backup        = false
    data_lake_bucket   = 'colabbio-data-lake-prevvy1'
}

// Container image definitions (Hosted in GitHub Container Registry)
process {
    withName: 'SLIDELAB_.*' {
        container = 'ghcr.io/colabbio/slidelab:latest'
    }
    withName: 'ABMIL_.*' {
        container = 'ghcr.io/colabbio/abmil-trainer:latest'
    }
    withName: 'MEDVFS_.*' {
        container = 'ghcr.io/colabbio/medvfs:latest'
    }
    withName: 'WRITE_OMERO_.*' {
        container = 'ghcr.io/colabbio/slidelab:latest'
    }
}

profiles {
    // Standard Local / Workstation with Docker
    standard {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '--entrypoint "" -v /data:/data --privileged -u 0:0'
    }
    
    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '--entrypoint "" --gpus all -v /data:/data --privileged -u 0:0'
    }

    // Generic HPC with Singularity / Apptainer (Zero Root Required)
    singularity {
        process.executor = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${baseDir}/singularity_cache"
    }

    // UCSF Wynton HPC Cluster (SLURM + Singularity + NVIDIA GPUs)
    wynton {
        process {
            executor = 'slurm'
            queue = 'gpu.q'
            clusterOptions = '--gres=gpu:1 --mem=32G -t 06:00:00'
        }
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "/wynton/scratch/${System.getenv('USER') ?: 'user'}/singularity_cache"
    }

    // Local / Cloud VM with NVIDIA GPUs
    gpu {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '--entrypoint "" --gpus all -v /data:/data --privileged -u 0:0'
    }

    // Instant Test Mode (Runs a synthetic 2-patient demo in 15 seconds)
    test {
        params.cohort_csv = "${baseDir}/conf/test_cohort.csv"
        params.device = 'cpu'
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '--entrypoint "" -u 0:0'
    }

    // Kubernetes Cluster Execution (MicroK8s / GKE with MedVFS PVC)
    k8s {
        process {
            executor = 'k8s'
            pod = [
                [volumeClaim: 'medvfs-wsi-pvc', mountPath: '/data/vfs']
            ]
        }
        k8s {
            namespace = 'colabbio-dev'
            serviceAccount = 'nextflow-sa'
            pullPolicy = 'IfNotPresent'
            storageClaimName = 'nextflow-work-pvc'
            storageMountPath = '/workspace/work'
        }
    }
}
