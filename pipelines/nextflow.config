process {
    executor = 'k8s'
    
    // Asumimos que MedVFS ya ha materializado la data en medvfs-wsi-pvc (legacy mode),
    // o que un sidecar de MedVFS provee el FUSE mount de forma dinámica.
    pod = [
        [volumeClaim: 'medvfs-wsi-pvc', mountPath: '/data/vfs']
    ]
}

k8s {
    namespace = 'colabbio-dev'
    serviceAccount = 'nextflow-sa'
    pullPolicy = 'Always'
    storageClaimName = 'nextflow-work-pvc'
    storageMountPath = '/workspace/work'
}
